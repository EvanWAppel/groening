"""Shared DuckDB access for the Streamlit app.

The app reads the dbt-built marts straight out of ``__DB__.duckdb`` (materialized
by ``build_warehouse.py`` + ``dbt build``).
"""

from pathlib import Path

import duckdb
import pandas as pd
import streamlit as st

DB_PATH = Path(__file__).parent / "__DB__.duckdb"


@st.cache_resource
def _connection() -> duckdb.DuckDBPyConnection:
    """One shared read-only connection to the warehouse file."""
    return duckdb.connect(str(DB_PATH), read_only=True)


@st.cache_data(ttl=3600, show_spinner=False)
def query(sql: str) -> pd.DataFrame:
    """Run a query and return a DataFrame (fresh cursor per call, thread-safe)."""
    return _connection().cursor().execute(sql).df()
