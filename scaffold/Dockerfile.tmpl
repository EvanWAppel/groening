FROM python:3.12-slim

WORKDIR /app

# Install Python dependencies first for better layer caching.
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# App source.
COPY . .

# Bake the DuckDB warehouse into the image at build time (a release phase runs in
# a throwaway container, so the build must happen here). The DB stays out of git
# and is rebuilt fresh on every deploy.
RUN python build_warehouse.py && dbt build --profiles-dir .

EXPOSE 8501
CMD ["sh", "-c", "streamlit run streamlit_app.py --server.port ${PORT:-8501} --server.address 0.0.0.0"]
